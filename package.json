    "type": "git",
    "url": "https://github.com/rohanvijaykumar/motion-lyrics.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/bundler": "4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/fonts": "4.0.547",
    "@remotion/google-fonts": "4.0.547",
    "@remotion/layout-utils": "4.0.547",
    "@remotion/lottie": "4.0.547",
    "@remotion/media": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "@remotion/zod-types": "4.0.547",
    "lottie-web": "5.13.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.547",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.547",
    "@types/node": "26.6.10",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "scripts": {
    "make": "tsx scripts/cli.ts make",
    "new": "tsx scripts/cli.ts new",
    "align": "tsx scripts/cli.ts align",
    "review": "tsx scripts/cli.ts review",
    "render": "tsx scripts/cli.ts render",
    "still": "tsx scripts/cli.ts still",
    "shift": "tsx scripts/cli.ts shift",
    "validate": "tsx scripts/cli.ts validate",
    "studio": "tsx scripts/cli.ts studio",
    "presets": "tsx scripts/cli.ts presets",
    "doctor": "tsx scripts/cli.ts doctor",
    "setup": "tsx scripts/cli.ts setup",
    "schema": "tsx scripts/cli.ts schema",
    "bench": "tsx scripts/cli.ts bench",
    "ml": "tsx scripts/cli.ts",
    "dev": "tsx scripts/cli.ts studio",
    "test": "vitest run",
    "lint": "eslint src scripts && tsc",
    "typecheck": "tsc",
    "qc": "tsx scripts/cli.ts qc",
    "approve": "tsx scripts/cli.ts approve"
  },
  "allowScripts": {
    "esbuild": false
  },
  "keywords": [
    "remotion",
    "lyrics",
    "karaoke",
    "lyric-video",
    "captions",
    "forced-alignment",
    "multilingual",
